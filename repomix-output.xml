    .comparator-slider::-moz-range-thumb {
      width: 4px;
      height: 100%;
      background: transparent;
      cursor: ew-resize;
      border: none;
    }

    input[type="range"]:not(.comparator-slider) {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
