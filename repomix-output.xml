    skinTone,
    setSkinTone,
    generatedImages,
    isLoading,
    regeneratingStates,
    error,
    generationStatus,
    generationProgress,
    POSE_LABELS,
    POSES,
    FRAMES,
    BACKGROUND_LABELS,
    HAIR_STYLES,
    SKIN_TONES,
    handleStartOver,
