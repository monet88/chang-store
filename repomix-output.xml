/** Tailwind CSS v4 - main styles entry point */
@import 'tailwindcss';

/* Content sources - scan all files for Tailwind classes */
@source "../**/*.tsx";
@source "../**/*.ts";
@source "../index.html";

@theme {
  --workspace-bg: #050505;
  --workspace-surface: rgba(17, 19, 23, 0.82);
  --workspace-stage: rgba(12, 14, 17, 0.9);
  --workspace-border: rgba(255, 255, 255, 0.08);
  --workspace-border-strong: rgba(255, 255, 255, 0.16);
  --workspace-text: #f5f5f4;
