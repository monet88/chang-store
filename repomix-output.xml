      letter-spacing: 0.16em;
      text-transform: uppercase;
      border-radius: 9999px;
      pointer-events: none;
    }

    .comparator-label.before {
      left: 1rem;
    }

    .comparator-label.after {
      right: 1rem;
    }

    .comparator-slider {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: ew-resize;
      z-index: 10;
    }

    .comparator-handle {
      position: absolute;
      top: 0;
      left: 50%;
      width: 2px;
      height: 100%;
      background: rgba(255, 255, 255, 0.82);
      transform: translateX(-50%);
      pointer-events: none;
      z-index: 5;
    }

    .comparator-handle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 44px;
      height: 44px;
      background-color: rgba(9, 9, 11, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.28);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='2' stroke='white'%3e%3cpath stroke-linecap='round' stroke-linejoin='round' d='M15 19l-7-7 7-7M9 5l7 7-7 7' /%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: center;
      background-size: 60%;
    }

    .comparator-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 4px;
      height: 100%;
      background: transparent;
      cursor: ew-resize;
