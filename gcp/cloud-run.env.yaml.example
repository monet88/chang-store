GATEWAY_API_KEYS: "replace-this-with-a-real-production-key"
GATEWAY_CORS_ORIGINS: "https://your-app-domain.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
GOOGLE_APPLICATION_CREDENTIALS: "/run/secrets/vertex-account.json"
GOOGLE_VERTEX_PROJECT: "your-gcp-project-id"
GOOGLE_VERTEX_LOCATION: "global"
GOOGLE_GENAI_API_VERSION: "v1"
GATEWAY_MAX_JSON_BYTES: "8388608"
GATEWAY_MAX_IMAGES: "4"
GATEWAY_MAX_DECODED_IMAGE_BYTES: "6291456"
GATEWAY_UPSTREAM_TIMEOUT_MS: "45000"
GATEWAY_UPSTREAM_CONCURRENCY: "4"
GATEWAY_STREAM_MAX_DURATION_MS: "240000"
GATEWAY_STREAM_IDLE_TIMEOUT_MS: "30000"
GATEWAY_STREAM_PER_KEY_LIMIT: "2"
GATEWAY_STREAM_QUEUE_LIMIT: "4"
GATEWAY_ALLOW_WILDCARD_CORS: "false"
GATEWAY_ENABLE_GEMINI_ROUTES: "true"
GATEWAY_ENABLE_VERTEX_ROUTES: "true"
GATEWAY_ENABLE_VTX_ROUTES: "true"
GATEWAY_ENABLE_IMAGE_ROUTES: "true"
