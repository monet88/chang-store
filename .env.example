# Chang-Store Environment Variables
# Copy this file to .env.local and fill in your values

# Gemini API Key - Required for AI features
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID - Required for Google Drive sync
# Create one at: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application type)
# 2. Add authorized JavaScript origins: http://localhost:3000, your_production_domain
# 3. Copy the Client ID here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# First-party auth session secret - required for server-side login/session APIs
# Use a long random string in production.
AUTH_SECRET=replace_with_a_long_random_secret

# Session duration in hours for the seeded-auth MVP
AUTH_SESSION_TTL_HOURS=72

# Seeded users for phase-1 login. Prefer passwordHash over plaintext passwords.
# Example: [{"username":"demo","passwordHash":"scrypt$...","displayName":"Demo User"}]
# WARNING: Setting this to "[]" (empty JSON array) overrides dev defaults and
# makes login impossible. Leave blank/unset to use built-in dev defaults.
AUTH_SEEDED_USERS_JSON=

# Feature flags -- reserved for future use (not consumed by current runtime)
# Auth always renders; backend endpoints respond if backend is deployed
VITE_ENABLE_AUTH=false

# Reserved for future job queue gating
VITE_ENABLE_JOB_QUEUE=false

# Neon Postgres connection string (from Vercel Marketplace > Neon)
# Format: postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# Vercel Blob read-write token (from Vercel Dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Vercel Blob storage toggle -- reserved for future use (not consumed by current runtime)
VITE_ENABLE_BLOB_STORAGE=false
