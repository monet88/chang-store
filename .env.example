# Chang-Store Environment Variables
# Copy this file to .env.local and fill in your values

# CPA gateway key (CLIProxyAPI) — the app always routes Gemini through
# https://cliproxy.monet.uno, so this is the key that matters.
# Set it to avoid pasting the key into Settings on every browser.
CLIPROXY_API_KEY=your_cpa_gateway_api_key_here

# Google OAuth Client ID - Required for Google Drive sync
# Create one at: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application type)
# 2. Add authorized JavaScript origins: http://localhost:3000, your_production_domain
# 3. Copy the Client ID here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- Provider Studios (optional) ---
# Keys can also be entered at runtime in each studio's settings panel.
# These build-time values only provide a default.

# Grok (xAI) studio — get a key at https://console.x.ai
GROK_API_KEY=your_grok_api_key_here
# GROK_BASE_URL=https://api.x.ai/v1

# GPT Image (OpenAI) studio — get a key at https://platform.openai.com/api-keys
GPT_IMAGE_API_KEY=your_openai_api_key_here
# GPT_IMAGE_BASE_URL=https://api.openai.com/v1
