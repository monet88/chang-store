#!/usr/bin/env bash
# Check that Harness docs mirror the current repo and durable state.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HARNESS_DB="${HARNESS_DB:-$REPO_ROOT/harness.db}"

cd "$REPO_ROOT"

python3 - <<'PY'
import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

root = Path.cwd()
errors: list[str] = []


def fail(message: str) -> None:
    errors.append(message)


def git_ls_files() -> set[str]:
    result = subprocess.run(
        ["git", "ls-files"],
        cwd=root,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}

tracked = git_ls_files()

# 1. Stable Harness entrypoint must be executable both on disk and in Git index.
harness_path = root / "scripts/harness"
if not os.access(harness_path, os.X_OK):
    fail("scripts/harness is not executable on disk; run: chmod +x scripts/harness")

stage = subprocess.run(
    ["git", "ls-files", "--stage", "scripts/harness"],
    cwd=root,
    check=True,
    text=True,
    stdout=subprocess.PIPE,
).stdout.strip()
if not stage.startswith("100755 "):
    fail("scripts/harness is not executable in git index; run: git update-index --chmod=+x scripts/harness")

# 2. HARNESS_COMPONENTS.md inventory rows must point to tracked files/globs or
# explicitly local generated artifacts.
components = (root / "docs/HARNESS_COMPONENTS.md").read_text()
match = re.search(r"## File Inventory\n(?P<body>.*?)(?:\n## Coverage Summary|\Z)", components, re.S)
if not match:
    fail("docs/HARNESS_COMPONENTS.md is missing the File Inventory section")
else:
    allowed_local = {"scripts/bin/harness-cli", "harness.db"}
    for line in match.group("body").splitlines():
        if not line.startswith("| `"):
            continue
        path_match = re.match(r"\| `([^`]+)`", line)
        if not path_match:
            continue
        ref = path_match.group(1)
        if "(" in ref:
            ref = ref.split("(", 1)[0].strip()
        if ref in allowed_local:
            continue
        if "*" in ref:
            prefix = ref.split("*", 1)[0]
            if not any(path.startswith(prefix) for path in tracked):
                fail(f"HARNESS_COMPONENTS inventory glob has no tracked match: {ref}")
            continue
        if ref not in tracked:
            fail(f"HARNESS_COMPONENTS inventory references missing/untracked file: {ref}")

def markdown_table_rows(path: Path, first_header: str) -> list[list[str]]:
    rows: list[list[str]] = []
    for line in path.read_text().splitlines():
        if not line.startswith("| ") or line.startswith(f"| {first_header} ") or line.startswith("| ---"):
            continue
        fields = [part.strip() for part in line.strip().strip("|").split("|")]
        if fields and fields[0]:
            rows.append(fields)
    return rows


def empty_to_text(value: object) -> str:
    return "" if value is None else str(value)


# 3. TEST_MATRIX.md mirrors durable story ids and statuses.
matrix_path = root / "docs/TEST_MATRIX.md"
backlog_path = root / "docs/HARNESS_BACKLOG.md"
db_path = Path(os.environ.get("HARNESS_DB", root / "harness.db"))
if not db_path.exists():
    fail("harness.db is missing; run: scripts/harness init && scripts/harness import brownfield")
else:
    with sqlite3.connect(db_path) as db:
        if not matrix_path.exists():
            fail("docs/TEST_MATRIX.md is missing")
        else:
            docs_rows = {
                fields[0]: fields[6]
                for fields in markdown_table_rows(matrix_path, "Story")
                if len(fields) >= 7 and fields[0] != "TBD"
            }
            durable_rows = dict(db.execute("SELECT id, status FROM story ORDER BY id"))
            if docs_rows != durable_rows:
                fail(f"docs/TEST_MATRIX.md story/status rows differ from harness.db: docs={docs_rows}, db={durable_rows}")

        # 4. HARNESS_BACKLOG.md mirrors durable backlog id/title/status rows.
        if not backlog_path.exists():
            fail("docs/HARNESS_BACKLOG.md is missing")
        else:
            docs_backlog = {
                fields[0]: (fields[1], fields[2])
                for fields in markdown_table_rows(backlog_path, "ID")
                if len(fields) >= 3 and fields[0].isdigit()
            }
            durable_backlog = {
                str(row[0]): (empty_to_text(row[1]), empty_to_text(row[2]))
                for row in db.execute("SELECT id, title, status FROM backlog ORDER BY id")
            }
            if docs_backlog != durable_backlog:
                fail(f"docs/HARNESS_BACKLOG.md id/title/status rows differ from harness.db: docs={docs_backlog}, db={durable_backlog}")

if errors:
    print("Harness docs sync check failed:")
    for error in errors:
        print(f"- {error}")
    sys.exit(1)

print("Harness docs sync check passed.")
PY
